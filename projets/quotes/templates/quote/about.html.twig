{% extends 'base.html.twig' %}

{% block title %}À propos - Citations Inspirantes{% endblock %}

{% block body %}
<div class="main-container">
    <section class="about-section" style="padding: 4rem 0;">
        <div class="section-container">
            <div style="text-align: center; margin-bottom: 3rem;">
                <h1 style="font-size: 3rem; color: white; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">À propos de nous</h1>
                <p style="color: rgba(255,255,255,0.9); font-size: 1.2rem;">Découvrez l'histoire et la mission de Citations Inspirantes</p>
            </div>

            <div style="max-width: 800px; margin: 0 auto;">
                <div style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); padding: 3rem; border-radius: 20px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
                    <h2 style="color: #4a5568; margin-bottom: 1.5rem; text-align: center; display: flex; align-items: center; justify-content: center;">
                        <span style="margin-right: 0.5rem; font-size: 2rem;">🎯</span>
                        Notre Mission
                    </h2>
                    <p style="color: #2d3748; font-size: 1.2rem; line-height: 1.8; text-align: center;">
                        Citations Inspirantes a été créé pour partager la sagesse et l'inspiration à travers des mots qui touchent l'âme.
                        Notre mission est de vous accompagner quotidiennement avec des pensées positives qui illuminent votre parcours
                        et vous motivent à donner le meilleur de vous-même.
                    </p>
                </div>

                <div style="background: rgba(255, 255, 255, 0.95); padding: 3rem; border-radius: 20px; margin-bottom: 2rem; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
                    <h2 style="color: #4a5568; margin-bottom: 2rem; text-align: center; display: flex; align-items: center; justify-content: center;">
                        <span style="margin-right: 0.5rem; font-size: 2rem;">🛠️</span>
                        Technologies utilisées
                    </h2>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 1.5rem; border-radius: 15px; text-align: center; box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);">
                            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🌐</div>
                            <strong>Symfony 8</strong>
                        </div>
                        <div style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 1.5rem; border-radius: 15px; text-align: center; box-shadow: 0 5px 20px rgba(240, 147, 251, 0.3);">
                            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🐘</div>
                            <strong>PHP 8.4</strong>
                        </div>
                        <div style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); color: #4a5568; padding: 1.5rem; border-radius: 15px; text-align: center; box-shadow: 0 5px 20px rgba(168, 237, 234, 0.3);">
                            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🎨</div>
                            <strong>Twig & CSS3</strong>
                        </div>
                    </div>
                    <p style="text-align: center; color: #6c757d; font-style: italic;">
                        Une application moderne construite avec les meilleures technologies web
                    </p>
                </div>

                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 3rem; border-radius: 20px; box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);">
                    <h2 style="margin-bottom: 2rem; text-align: center; display: flex; align-items: center; justify-content: center;">
                        <span style="margin-right: 0.5rem; font-size: 2rem;">💡</span>
                        Fonctionnalités principales
                    </h2>
                    <div style="display: grid; gap: 1rem;">
                        <div style="display: flex; align-items: center; padding: 1rem; background: rgba(255,255,255,0.1); border-radius: 10px;">
                            <span style="margin-right: 1rem; font-size: 1.5rem;">📚</span>
                            <span><strong>Citation aléatoire :</strong> Découvrez une nouvelle source d'inspiration à chaque visite</span>
                        </div>
                        <div style="display: flex; align-items: center; padding: 1rem; background: rgba(255,255,255,0.1); border-radius: 10px;">
                            <span style="margin-right: 1rem; font-size: 1.5rem;">📋</span>
                            <span><strong>Collection complète :</strong> Parcourez toutes les citations disponibles en un coup d'œil</span>
                        </div>
                        <div style="display: flex; align-items: center; padding: 1rem; background: rgba(255,255,255,0.1); border-radius: 10px;">
                            <span style="margin-right: 1rem; font-size: 1.5rem;">✍️</span>
                            <span><strong>Contribution :</strong> Ajoutez vos propres citations pour enrichir la communauté</span>
                        </div>
                        <div style="display: flex; align-items: center; padding: 1rem; background: rgba(255,255,255,0.1); border-radius: 10px;">
                            <span style="margin-right: 1rem; font-size: 1.5rem;">📱</span>
                            <span><strong>Design responsive :</strong> Une expérience optimale sur tous vos appareils</span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="text-align: center; margin-top: 3rem;">
                <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">
                    🏠 Retour à l'accueil
                </a>
                <a href="{{ path('app_add_quote') }}" class="btn btn-secondary btn-lg">
                    ✨ Contribuer maintenant
                </a>
            </div>
        </div>
    </section>
</div>
{% endblock %}