{% extends 'base.html.twig' %}

{% block title %}Toutes les citations - Citations Inspirantes{% endblock %}

{% block body %}
<div class="quotes-container">
    <div class="section-container">
        <div class="quotes-header">
            <h1 class="section-title">📋 Toutes nos citations</h1>
            <p class="quotes-count">{{ quotes|length }} citations inspirantes à découvrir</p>
        </div>

        <ul class="quotes-list">
            {% for q in quotes %}
                <li class="fade-in">{{ q }}</li>
            {% else %}
                <li style="text-align: center; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); color: #6c757d; border-left: none; padding: 3rem;">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">💭</div>
                    <h3 style="margin-bottom: 1rem; color: #4a5568;">Aucune citation disponible</h3>
                    <p style="margin-bottom: 2rem;">Soyez le premier à partager votre inspiration !</p>
                    <a href="{{ path('app_add_quote') }}" class="btn btn-primary btn-lg">✨ Ajouter la première citation</a>
                </li>
            {% endfor %}
        </ul>

        <div style="text-align: center; margin-top: 3rem; padding-top: 2rem; border-top: 2px solid rgba(102, 126, 234, 0.2);">
            <a href="{{ path('app_home') }}" class="btn btn-outline btn-lg">🏠 Retour à l'accueil</a>
        </div>
    </div>
</div>
{% endblock %}
