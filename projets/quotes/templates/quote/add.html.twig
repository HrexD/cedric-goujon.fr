{% extends 'base.html.twig' %}

{% block title %}Ajouter une citation - Citations Inspirantes{% endblock %}

{% block body %}
<div class="add-container">
    <div class="section-container">
        <h1 class="section-title">✨ Partagez votre inspiration</h1>

        <div class="add-form fade-in">
            <h2 class="form-title">💬 Ajouter une citation</h2>

            <form method="post">
                <div class="form-group">
                    <label for="quote">Votre citation inspirante</label>
                    <textarea
                        name="quote"
                        id="quote"
                        rows="5"
                        placeholder="Partagez une pensée, une citation ou une phrase qui vous inspire..."
                        required
                    ></textarea>
                    <small style="color: #6c757d; font-size: 0.9rem; display: block; margin-top: 0.5rem;">
                        ✨ Votre citation peut inspirer et motiver d'autres personnes. Chaque mot compte !
                    </small>
                </div>

                <div style="text-align: center; margin-top: 2rem;">
                    <button type="submit" class="btn btn-primary btn-lg">
                        ✨ Publier la citation
                    </button>
                    <a href="{{ path('app_home') }}" class="btn btn-outline btn-lg">
                        🏠 Retour à l'accueil
                    </a>
                </div>
            </form>

            <div class="feature-card" style="margin-top: 3rem;">
                <div class="feature-icon">💡</div>
                <h3 class="feature-title">Conseils pour une citation inspirante</h3>
                <div class="feature-description">
                    <p>• Choisissez des mots qui résonnent avec vos expériences</p>
                    <p>• Privilégiez la simplicité et la clarté</p>
                    <p>• Transmettez un message positif et motivant</p>
                    <p>• Laissez votre authenticité transparaître</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
